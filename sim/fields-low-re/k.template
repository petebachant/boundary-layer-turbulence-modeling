FoamFile
{{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

// k ~ 3/2 * (U*I)^2
internalField   uniform {k_inlet};

boundaryField
{{
    inlet
    {{
        type            fixedValue;
        value           $internalField;
    }}

    outlet
    {{
        type            zeroGradient;
    }}

    upperWall
    {{
        type            zeroGradient;
        value           $internalField;
    }}

    lowerWall
    {{
        type            zeroGradient;
        value           $internalField;
    }}

    plate
    {{
        // Wall-resolved: k vanishes at the wall, no wall function
        type            fixedValue;
        value           uniform 1e-12;
    }}

    frontAndBack
    {{
        type            empty;
    }}
}}


// ************************************************************************* //
