FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (1 0 0);
    }

    outlet
    {
        type            zeroGradient;
    }

    upperWall
    {
        // NOTE: a zeroGradient top lets the displaced boundary layer
        // accelerate the free stream through blockage (+0.75% along the
        // plate, where the DNS decelerates by 1.3%). Replacing it with a
        // pressureInletOutletVelocity far field was tried and is far worse:
        // the fixed far-field pressure drains the domain, Ue collapses to
        // 0.68 by the end of the plate and the boundary layer grows to 2.6x
        // the DNS thickness. Keeping zeroGradient; a taller domain is the
        // right fix for the residual 2% if it matters.
        type            zeroGradient;
    }

    lowerWall
    {
        type            zeroGradient;
    }

    plate
    {
        type            noSlip;
    }

    frontAndBack
    {
        type            empty;
    }
}


