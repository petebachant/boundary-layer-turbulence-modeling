// Stations spanning the laminar, transitional and turbulent regions of the
// JHTDB transitional boundary layer, so a model can be scored on the whole
// plate rather than at a single downstream location.

type sets;
libs (sampling);
writeControl onEnd;
setFormat csv;
fields (U p k omega gamma nut);
interpolationScheme cellPoint;

sets
{
