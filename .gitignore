# pyenv. Normally machine-local, but here each uv environment pins its own
# interpreter as a project fact -- py-jhtdb needs 3.11 for pyjhtdb while
# everything else is on 3.14 -- so those are tracked.
.python-version
!.python-version
!envs/*/.python-version
